{
  "name": "sislar-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API do SISLAR — Lar do Irmão Velho",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "prisma generate && node src/db/setup.js",
    "test": "prisma generate && node --env-file=.env.test --test --test-concurrency=1 tests/rules.test.js tests/api.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "prisma": "^6.19.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  },
  "allowScripts": {
    "prisma@6.19.0": true,
    "@prisma/client@6.19.0": true,
    "@prisma/engines@6.19.0": true
  }
}
