  users_documents_author_idTousers      users     @relation("documents_author_idTousers", fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patients                              patients  @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
