model evolutions {
  id                    String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  patient_id            String
  at                    DateTime                @db.Timestamptz(6)
  author_id             String
  type                  String
  title                 String
  description           String
  notes                 String?
  alimentacao           String?
  hidratacao            String?
  sono                  String?
  humor                 String?
  mobilidade            String?
  pele                  String?
  status                String
  closed_at             DateTime?               @db.Timestamptz(6)
  linked_occurrence_id  String?
  evolution_corrections evolution_corrections[]
  users                 users                   @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patients              patients                @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([patient_id, at(sort: Desc)], map: "evolutions_patient_at")
}

