generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model administrations {
  id              String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  prescription_id String
  patient_id      String
  medication_id   String
  scheduled_at    DateTime      @db.Timestamptz(6)
  administered_at DateTime?     @db.Timestamptz(6)
  status          String
  author_id       String
  notes           String?
  users           users         @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  medications     medications   @relation(fields: [medication_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patients        patients      @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prescriptions   prescriptions @relation(fields: [prescription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model agenda_events {
  id              String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  title           String
  patient_id      String?
  professional_id String
  starts_at       DateTime  @db.Timestamptz(6)
  ends_at         DateTime  @db.Timestamptz(6)
  kind            String
  status          String
  notes           String?
  patients        patients? @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users     @relation(fields: [professional_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model appointments {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  patient_id      String
  specialty       String
  professional_id String
  at              DateTime @db.Timestamptz(6)
  summary         String
  status          String
  patients        patients @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users    @relation(fields: [professional_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model audit_log {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id   String?
  action    String
  entity    String
  entity_id String?
  at        DateTime @default(now()) @db.Timestamptz(6)
  payload   Json     @default("{}")
  users     users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model care_plan_actions {
  id             String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  plan_id        String
  title          String
  responsible_id String
  frequency      String
  done           Boolean    @default(false)
  care_plans     care_plans @relation(fields: [plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users      @relation(fields: [responsible_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model care_plan_updates {
  id         String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  plan_id    String
  at         DateTime   @default(now()) @db.Timestamptz(6)
  by_id      String
  text       String
  users      users      @relation(fields: [by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  care_plans care_plans @relation(fields: [plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model care_plans {
  id                String              @id @default(dbgenerated("(gen_random_uuid())::text"))
