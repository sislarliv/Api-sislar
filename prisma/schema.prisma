  title             String
  area              String
  objective         String
  responsible_id    String
  start_date        DateTime            @db.Date
  end_date          DateTime?           @db.Date
  status            String
  care_plan_actions care_plan_actions[]
  care_plan_updates care_plan_updates[]
  patients          patients            @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users               @relation(fields: [responsible_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model dispensations {
  id              String          @id @default(dbgenerated("(gen_random_uuid())::text"))
